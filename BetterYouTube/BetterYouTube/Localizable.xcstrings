            "value" : "Regarder maintenant"
          }
        }
      }
    },
    "Watch a few videos and this feed will fill up with more from the channels you spend time on." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regarde quelques vidéos et ce fil se remplira de vidéos des chaînes où tu passes du temps."
