            "value" : "Quitter la démo"
          }
        }
      }
    },
    "Quitting deletes the demo's library, searches and downloads. Your own library, sign-ins and iCloud sync carry on as they were." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
