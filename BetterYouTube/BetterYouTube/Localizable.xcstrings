          }
        }
      }
    },
    "Watch Later is synced with the account connected to youtube.com." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« À regarder plus tard » est synchronisé avec le compte connecté à youtube.com."
