    },
    "As you type, what is in the search field is sent to YouTube's suggestion service, which costs no quota. Turned off, the field suggests only your recent searches." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant la saisie, le contenu du champ de recherche est envoyé au service de suggestions de YouTube, qui ne consomme pas de quota. Désactivé, le champ ne propose que tes recherches récentes."
          }
        }
      }
    },
