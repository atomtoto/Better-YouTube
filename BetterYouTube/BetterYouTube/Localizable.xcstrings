          "stringUnit" : {
            "state" : "translated",
            "value" : "Playlists"
          }
        }
      }
    },
    "Playlists you create or save on YouTube appear here." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les playlists que tu crées ou enregistres sur YouTube apparaissent ici."
          }
        }
      }
    },
    "Plays the next video in the list when one ends. Turned off, YouTube's own suggestions stay on screen at the end instead. In a car, the queue always continues." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lance la vidéo suivante de la liste quand une vidéo se termine. Désactivée, ce sont les suggestions de YouTube qui restent à l’écran à la fin. En voiture, la file d’attente continue toujours."
          }
        }
      }
    },
    "Plays the video you watched last, from where you stopped." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit la dernière vidéo que tu as regardée, là où tu t’es arrêté."
          }
