    "iCloud Sync" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchro iCloud"
          }
        }
      }
    },
    "iCloud account changed. Turn sync on to merge this device's library with the new account." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte iCloud a changé. Active la synchro pour fusionner la bibliothèque de cet appareil avec le nouveau compte."
          }
        }
      }
    },
    "iCloud isn't available in this build: it was signed without iCloud, as a free Apple developer account requires. Your library stays on this device." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud n’est pas disponible dans cette version : elle a été signée sans iCloud, comme l’impose un compte développeur Apple gratuit. Ta bibliothèque reste sur cet appareil."
          }
        }
      }
    },
    "iCloud signed out. Your library is kept on this device." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déconnecté d’iCloud. Ta bibliothèque est conservée sur cet appareil."
          }
        }
      }
    },
    "iCloud storage is full. Free some space to continue syncing." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le stockage iCloud est plein. Libère de l’espace pour continuer la synchro."
          }
        }
      }
    },
