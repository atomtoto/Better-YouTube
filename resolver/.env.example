# Copy to .env and edit. `docker compose up -d` reads it automatically.

# The address your PHONE reaches the resolver on. On the same wi-fi this is your machine's LAN
# address; over the internet it is whatever your tunnel or reverse proxy serves.
PUBLIC_URL=http://192.168.1.20:8080

# Optional. Any random string; paste the same one into the app.
#   openssl rand -hex 16
RESOLVER_TOKEN=

MAX_HEIGHT=1080
ALLOW_MUX=1
