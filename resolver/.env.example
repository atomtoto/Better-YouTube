# Copy to .env and edit. `docker compose up -d` reads it automatically.
# Every one of these has a working default — an empty .env is a valid .env.

# Set this on anything reachable from outside your own network. Without it, whoever finds the
# address can use your resolver.
#   openssl rand -hex 16
RESOLVER_TOKEN=

MAX_HEIGHT=1080

# 0 means this server never carries video: it only answers questions, and downloads are capped at
# whatever YouTube already offers joined.
ALLOW_MUX=1

# How long the setup page at / stays open after a restart. 0 turns it off.
SETUP_MINUTES=30

# Almost never needed: the server works its own address out from each request. Only set this if
# it is reached somewhere neither Host nor X-Forwarded-Host reports correctly.
# PUBLIC_URL=

# Only if YouTube demands a sign-in — which mostly happens when this runs at a hosting provider.
# The downloads become the account that exported these cookies, and using an account from a
# datacenter address is a good way to get it limited. Running this at home avoids the whole thing.
# COOKIES_FILE=/cookies/youtube.txt

# A different yt-dlp player client to try. Only when a yt-dlp issue thread names one.
# PLAYER_CLIENT=ios,web
